# Kopieer dit bestand naar ".env" en vul je eigen sleutels in.
# Het bestand .env komt NIET op GitHub (het staat in .gitignore).

# ── Supabase (verplicht) ── Supabase → Project Settings → API
VITE_SUPABASE_URL=https://jouwproject.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://jouwproject.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim! Alleen op de server gebruiken.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Optioneel, alleen voor drizzle-kit (Supabase → Connect → Session pooler).
# De database opbouwen doe je met supabase/database-in-een-keer.sql (zie README).
DATABASE_URL=postgresql://postgres.jouwproject:wachtwoord@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Het adres waarop je app online staat (voor links in mails)
SITE_URL=https://ceritaproject.nl

# ── Stripe (shop) ── dashboard.stripe.com → Developers → API keys
# pk_test_ = testbetalingen, pk_live_ = echte betalingen
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_SECRET_KEY=sk_live_...

# ── OpenAI (spraak naar tekst + AI-hulp bij meldingen) ── platform.openai.com
OPENAI_API_KEY=sk-...
# Optioneel: andere modellen kiezen
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ── Firebase (pushmeldingen) ── console.firebase.google.com
# Project settings → General → Your apps (web-app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=
# Project settings → Service accounts → Generate new private key (hele JSON op één regel)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# ── Eigen mails in Cerita-stijl (optioneel) ── resend.com
# Zonder deze drie stuurt Supabase gewoon zijn eigen standaardmails.
RESEND_API_KEY=re_...
EMAIL_FROM=CeritaProject <noreply@notify.ceritaproject.nl>
# Supabase → Authentication → Hooks → Send Email hook → secret
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

